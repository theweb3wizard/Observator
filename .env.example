# Observator environment — copy to .env and fill in. Never commit real secrets.
# See OBSERVATOR_MASTER_BUILD_SPEC.md §26.

NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=

# Devnet USDC mint (Circle): 4zMMC9srt5Ri5X14GAgXhaHii3Gn9VQTzRpWhq1FUD9
# Set NEXT_PUBLIC_USDC_MINT to the above unless using a custom test mint.

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_PRIVATE_KEY=

DATABASE_URL=
# Local/dev default when unset: ./data/observator.db (SQLite, zero deps).
# Production: Neon Postgres pooled connection string
# (postgresql://USER:PASSWORD@HOST/neondb?sslmode=require).
# Get it via the Neon API: /projects/{id}/connection_uri (pooled=true).

# Neon API key (local tooling only — never commit, never deploy).
NEON_API_KEY=

VERIFIER_BASE_URL=http://localhost:3001

MCP_SERVER_URL=http://localhost:3002

AI_PROVIDER_API_KEY=

X402_FACILITATOR_URL=https://x402.org/facilitator
X402_ENABLED=0
X402_PAY_TO=
X402_PRICE=$0.001
